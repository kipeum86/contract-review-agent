node_modules/
.claude/settings.local.json
*.pyc
__pycache__/
.DS_Store
/tmp/
*.log
.env
.env.*

# Contracts to review — drop here (confidential - do not commit)
/input/*
!/input/.gitkeep

# Review results and deliverables (confidential - do not commit)
/output/*
!/output/.gitkeep

# Library assets containing real contract content (confidential - do not commit)
/contract-review/library/inbox/raw/*
!/contract-review/library/inbox/raw/.gitkeep
/contract-review/library/inbox/sidecars/*
!/contract-review/library/inbox/sidecars/.gitkeep
/contract-review/library/staging/*
!/contract-review/library/staging/.gitkeep
/contract-review/library/approved/*
!/contract-review/library/approved/.gitkeep
!/contract-review/library/approved/templates/
/contract-review/library/approved/templates/*
!/contract-review/library/approved/templates/*/
/contract-review/library/approved/templates/*/*
!/contract-review/library/approved/templates/*/0-*-seed/
!/contract-review/library/approved/templates/*/0-*-seed/**
/contract-review/library/quarantine/*
!/contract-review/library/quarantine/.gitkeep

# Generated library indexes (local-only; rebuild from local approved assets)
/contract-review/library/indexes/*.json
!/contract-review/library/indexes/.gitkeep
!/contract-review/library/indexes/README.md

# User-customized policies (gitignored — defaults ship in policies.default/)
/contract-review/library/policies/*
!/contract-review/library/policies/.gitkeep

# Matter working directories (confidential - do not commit)
/contract-review/matters/*
!/contract-review/matters/.gitkeep

# Unified local runtime workspace (confidential - do not commit)
/contract-review/workspace/input/*
!/contract-review/workspace/input/.gitkeep
/contract-review/workspace/output/*
!/contract-review/workspace/output/.gitkeep
/contract-review/workspace/logs/*
!/contract-review/workspace/logs/.gitkeep
/contract-review/workspace/matters/*
!/contract-review/workspace/matters/.gitkeep
/contract-review/workspace/runs/*
!/contract-review/workspace/runs/.gitkeep

# Domain-reference loader session traces (per-execution, never committed)
/contract-review/library/runs/ingestion/*
!/contract-review/library/runs/ingestion/.gitkeep
/contract-review/library/runs/sessions/*
!/contract-review/library/runs/sessions/.gitkeep

# Local-only scratch directory
/_private/*
!/_private/.gitkeep

# Local build, draft and log artifacts
release-note-*.md
package-lock.json
package-lock.json.backup-*
*quality-audit-log*
*build-log*
.gstack/
/logs/*
!/logs/.gitkeep

# Local-only planning docs
/docs/plans/*
!/docs/plans/README.md
