# OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...  # pragma: allowlist secret

# Optional: override the model id. Any OpenRouter model id with solid tool-use works.
# Default: anthropic/claude-sonnet-4.5
# Other good picks:
#   openai/gpt-4o
#   google/gemini-2.5-pro
# BINDU_AGENT_MODEL=anthropic/claude-sonnet-4.5

# Optional: max tokens per response (default 8192 - clause-by-clause reviews run long).
# BINDU_AGENT_MAX_TOKENS=8192

# Optional: display name in the Bindu agent card (default: bindu-contract-review).
# The "bindu-" prefix keeps the DID namespaced and avoids implying this is an
# official contract-review-agent endpoint.
# BINDU_AGENT_NAME=bindu-contract-review

# Optional: contact line baked into the public agent-card DID once BINDU_EXPOSE=true.
# Leave it as the placeholder if you are only running locally.
# BINDU_AGENT_AUTHOR=your_email_here@example.com

# Optional: absolute path to the contract-review-agent repo root. Only needed if you
# run this example from outside the repo (by default it is found two levels up).
# CONTRACT_REVIEW_REPO=/path/to/contract-review-agent

# Optional: open an FRP reverse tunnel so the agent's HTTP endpoint is reachable on
# the public internet. Default OFF. The endpoint is unauthenticated and any model-API
# key configured above is on the billing path. Read the README section "Network
# exposure & dependencies" before turning this on.
# BINDU_EXPOSE=false
